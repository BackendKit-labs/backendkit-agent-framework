# Application
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cloud_platform
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# Runtime (Fase 1: RuntimeSPI)
# Endpoint del daemon Docker. Windows: npipe:////./pipe/docker_engine
DOCKER_HOST=unix:///var/run/docker.sock
# Runtimes habilitados (coma-separados). Hoy: docker. k8s/process = coming_soon.
RUNTIME_ENABLED=docker
# Imagen por defecto si el agente no define image/config.image.
DEFAULT_AGENT_IMAGE=agent-runtime:latest