# ── BackendKit Platform — root .env for docker-compose ───────────────────────
# Copy to .env and fill required values before running: docker compose up -d

# ── Database passwords ────────────────────────────────────────────────────────
ABAC_DB_PASSWORD=change_me
DIRECTOR_DB_PASSWORD=change_me
CLOUD_DB_PASSWORD=change_me

# ── JWT / EdDSA keypair (shared across services) ──────────────────────────────
# Generar todos los secrets de una vez:
#   node scripts/generate-keypair.mjs
# Luego pegá la salida aquí.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# EdDSA Ed25519 — abac-service firma tokens, el resto verifica con la pública
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# ── Bootstrap admin (solo primer arranque — se ignora si el usuario ya existe) ─
# Si está definido, abac-service crea el primer admin al iniciar.
# Eliminar o dejar vacío después del primer deploy.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_secure_password

# ── M2M tokens para cloud-platform ───────────────────────────────────────────
# Generados automáticamente por abac-service al arrancar (si ED25519_PRIVATE_KEY está definida).
# Workflow:
#   1. docker compose up -d postgres-abac abac-service
#   2. docker compose logs abac-service | grep "CLOUD_M2M_TOKEN\|CLOUD_APP_ID"
#   3. Copiar los valores aquí y luego: docker compose up -d
# Dejar vacíos en el primer arranque — cloud-platform deniega por defecto hasta tener el token.
CLOUD_M2M_TOKEN=
CLOUD_APP_ID=

# ── Frontend secrets ──────────────────────────────────────────────────────────
# También generado por scripts/generate-keypair.mjs
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# ── WebSocket (director runtime) ──────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:3500

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
