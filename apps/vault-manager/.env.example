# Auth
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
AUTH_SALT=bk-vault-salt-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=file:./data/vault-manager.db

# LLM — used for improve chat AND curation via curator-codex-agent
DEEPSEEK_API_KEY=sk-...
LLM_MODEL=deepseek-chat

# curator-codex-agent (reads DEEPSEEK_API_KEY above automatically)
# Override if you want a different provider or model for curation:
# CURATOR_API_KEY=sk-...
# CURATOR_PROVIDER=deepseek          # deepseek | openai | anthropic | ollama
# CURATOR_MODEL=deepseek-reasoner    # default; use deepseek-chat for faster curation

# Vault paths (used by setup.ts to seed initial vault definitions)
AI_VAULT_PATH=C:/Users/mairon.cuello/development/workspace-ia/ai-vault
TS_VAULT_PATH=./vaults/typescript
ARCH_VAULT_PATH=./vaults/architecture
COMPANY_VAULT_PATH=./vaults/empresa
