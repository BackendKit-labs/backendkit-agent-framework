{
  "name": "@backendkit-labs/security-mcp",
  "version": "1.0.0",
  "description": "MCP server for OWASP security review. Activated automatically by Cable 2 when policy rules detect relevant keywords.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "security-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backendkit-labs/agent-coding": "*",
    "@backendkit-labs/agent-core": "*",
    "@backendkit-labs/infra": "*",
    "@backendkit-labs/mcp-server": "*",
    "dotenv": "^16.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
