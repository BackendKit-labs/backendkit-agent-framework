{
  "name": "@backendkit-labs/agent-flow-sql",
  "version": "0.1.0",
  "description": "RunJournal on SQL for @backendkit-labs/agent-core flows: SQLite and Postgres. Runs survive the process and any process sharing the database can resume them",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "peerDependencies": {
    "@backendkit-labs/agent-core": ">=0.45.0 <0.47.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^12.11.1",
    "jest": "^29.0.0",
    "pg": "^8.23.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/flow-sql"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
