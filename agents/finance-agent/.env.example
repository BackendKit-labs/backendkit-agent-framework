# ============================================================
# Finance Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the actual .env file to version control.

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Agent Configuration ---
MAX_CONCURRENT_AGENTS=4
TIMEOUT_MS=30000

# --- Redis (optional, for scheduler integration) ---
REDIS_PORT=6379
REDIS_HOST=localhost

# --- Scheduler Agent Integration ---
SCHEDULER_API_URL=http://scheduler-agent:4000
SCHEDULER_API_KEY=your-scheduler-api-key

# --- Notifier Agent Integration ---
NOTIFIER_API_URL=http://notifier-agent:5000
NOTIFIER_API_KEY=your-notifier-api-key

# --- API Gateway (ERP connection) ---
API_GATEWAY_URL=http://api-gateway:8080
API_GATEWAY_API_KEY=your-api-gateway-key
