# ── Auth Service — variables de entorno ──────────────────────────────────────
#
# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore — nunca subas secretos al repo.

# Clave compartida para firmar/verificar JWTs.
# DEBE ser idéntica en auth-service, director-agent y cualquier app que verifique tokens.
AUTH_SECRET=cambia-esta-clave-larga-y-segura

# Contraseña del primer usuario admin (se crea automáticamente si no existe ningún admin).
ADMIN_PASSWORD=AdminSeguro123!

# Path del SQLite (default: ~/.backendkit/auth/enterprise.db)
# AUTH_DB_PATH=/ruta/personalizada/enterprise.db

# Puerto — configurado en package.json como `next dev -p 4000`
# Para cambiarlo: editá el script "dev" en package.json
