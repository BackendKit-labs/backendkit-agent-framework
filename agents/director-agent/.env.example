# Copia este archivo a .env y completa tus claves.
# El director usa el provider configurado en director.yaml (default: deepseek).

# LLM
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...   (si cambias provider a openai en director.yaml)

# orchestrator-mcp-agent: ~/.backendkit/config/orchestrator-mcp.yaml se crea
# automaticamente en el primer arranque. Descomenta solo si usas config custom.
# ORCHESTRATOR_CONFIG=/ruta/personalizada/orchestrator-mcp.yaml

# fleet-agent: gateway de despliegue Docker/K8s
GATEWAY_URL=http://localhost:3400
# GATEWAY_API_KEY=         (si el gateway fue levantado con ORCHESTRATOR_API_KEY)

# Ruta al director.yaml (opcional, si no esta junto al binario)
# DIRECTOR_CONFIG=/path/to/director.yaml