{
  "name": "@backendkit-labs/document-extract",
  "version": "0.1.0",
  "description": "Extracts text from PDF, Word, Excel and CSV files, with limits and stable errors, for @backendkit-labs/agent-core agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
