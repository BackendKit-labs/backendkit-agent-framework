# Dónde vive AVAL.
AVAL_URL=http://localhost:3000

# La clave del agente en AVAL — la que devuelve POST /api/v1/agents al darlo de
# alta, o POST /api/v1/agents/{id}/keys al rotarla. NUNCA la clave de consola:
# ese es un error de credencial distinto, no de configuración de este agente.
AVAL_KEY=aval_sk_...

# El proveedor del LLM que razona cada corrida.
DEEPSEEK_API_KEY=...

# Cuándo corre. Por defecto: todos los días a las 9:00, hora del sistema.
# SCHEDULE_CRON="0 9 * * *"

# Dónde vive el JSON del origen de pagos programados (el mock). Por defecto:
# ~/.aval-scheduler/schedule.json — cámbialo si corres varias instancias en la
# misma máquina, o bórralo del todo cuando conectes un origen real.
# PAYMENTS_SOURCE_PATH=/ruta/a/schedule.json

# Corrida manual, además del cron: POST /run-now (con encabezado de firma
# HMAC-SHA256 estilo GitHub) fuerza una corrida ya mismo, sin esperar la
# próxima. Útil cuando alguien sube un tope en AVAL y no quiere esperar hasta
# mañana a las 9:00 para que el pago que había quedado denegado se reintente.
# Sin este secreto, no se abre ningún puerto de webhook — no hay valor por
# defecto a propósito, para no dejar un endpoint sin autenticación escuchando
# si alguien olvida configurarlo.
# SCHEDULER_WEBHOOK_SECRET=un-secreto-largo-y-propio-de-este-agente
# SCHEDULER_WEBHOOK_PORT=3100

# Panel admin: CRUD del calendario de pagos, historial de resultados, y un
# botón para disparar una corrida ahora. Vive en el mismo proceso que el
# agente (necesita acceso directo a agent.emit para el botón de "correr
# ahora"). Mismo apagado-por-defecto que el webhook: sin ADMIN_TOKEN no se
# levanta ningún servidor. El panel (GET /) pide el token una vez y lo guarda
# en localStorage del navegador — cada llamada a la API lo manda como
# "Authorization: Bearer <token>".
# ADMIN_TOKEN=otro-secreto-largo-y-propio-de-este-agente
# ADMIN_PORT=3200
