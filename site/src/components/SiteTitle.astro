---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---
<div class="title-row">
  <button type="button" class="sidebar-toggle" aria-label="Hide navigation" aria-controls="starlight__sidebar" aria-expanded="true" title="Hide navigation">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M9 4v16" />
    </svg>
  </button>
  <Default><slot /></Default>
</div>

<script>
  // Hide or show the navigation column; the choice is remembered (the early script in ThemeProvider applies it before paint).
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
  const sync = () => {
    const hidden = root.dataset.sidebar === 'hidden';
    button?.setAttribute('aria-expanded', String(!hidden));
    const label = hidden ? 'Show navigation' : 'Hide navigation';
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  };
  sync();
  button?.addEventListener('click', () => {
    const hidden = root.dataset.sidebar !== 'hidden';
    if (hidden) root.dataset.sidebar = 'hidden';
    else delete root.dataset.sidebar;
    try { localStorage.setItem('bk-sidebar', hidden ? 'hidden' : 'shown'); } catch {}
    sync();
  });
</script>
