{
  "name": "mock-erp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mock ERP: API REST propia (simula un ERP real) + adaptador MCP delante, para probar la integración de finance-agent con sistemas externos",
  "scripts": {
    "dev:api": "ts-node src/erp-api/server.ts",
    "dev:mcp": "ts-node src/mcp-adapter/server.ts",
    "build": "tsc",
    "start:api": "node dist/erp-api/server.js",
    "start:mcp": "node dist/mcp-adapter/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
