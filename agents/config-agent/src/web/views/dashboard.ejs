<%- include('partials/status-badge') %>

<h1>Dashboard</h1>
<p class="subtitle">Agentes de configuración disponibles</p>

<div class="stats-bar">
  <div class="stat">
    <span class="stat-value"><%= agents.length %></span>
    <span class="stat-label">Agentes</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= config.settings.autoValidate ? '✅' : '❌' %></span>
    <span class="stat-label">Auto-validar</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= config.settings.autoDetectEnv ? '✅' : '❌' %></span>
    <span class="stat-label">Auto-detect env</span>
  </div>
</div>

<div class="agent-grid">
  <% if (agents.length === 0) { %>
    <div class="empty-state">
      <p>No hay agentes configurados aún.</p>
      <p>Usá <code>set_config</code> para crear la primera configuración.</p>
    </div>
  <% } %>

  <% for (const agent of agents) { %>
    <div class="agent-card">
      <div class="agent-card-header">
        <h3><%= agent %></h3>
        <span class="badge badge-ok">Configurado</span>
      </div>
      <div class="agent-card-actions">
        <a href="/config/<%= agent %>" class="btn">✏️ Editar</a>
        <a href="/history/<%= agent %>" class="btn">📋 Historial</a>
        <a href="/diff/<%= agent %>" class="btn">📊 Diff</a>
      </div>
    </div>
  <% } %>
</div>
