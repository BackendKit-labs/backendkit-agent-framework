{
  "name": "@backendkit-labs/agent-testkit",
  "version": "0.1.7",
  "description": "Test doubles for @backendkit-labs/agent-core agents: scripted providers, a mock OpenAI-compatible LLM server with injectable failures, a mock transport and assertions about the real world",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "peerDependencies": {
    "@backendkit-labs/agent-core": ">=0.29.0 <0.38.0"
  },
  "devDependencies": {
    "@backendkit-labs/agent-providers": "^0.3.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/testkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
