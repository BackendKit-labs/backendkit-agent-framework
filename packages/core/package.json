{
  "name": "@backendkit-labs/agent-core",
  "version": "0.41.0",
  "description": "Generic multi-agent engine — model-agnostic, transport-agnostic",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./triggers": {
      "types": "./dist/triggers/index.d.ts",
      "default": "./dist/triggers/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./memory": {
      "types": "./dist/agent-memory/index.d.ts",
      "default": "./dist/agent-memory/index.js"
    },
    "./discovery": {
      "types": "./dist/agent-discovery/index.d.ts",
      "default": "./dist/agent-discovery/index.js"
    },
    "./reflection": {
      "types": "./dist/reflection/index.d.ts",
      "default": "./dist/reflection/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "default": "./dist/skills/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@backendkit-labs/bulkhead": "^0.2.1",
    "@backendkit-labs/circuit-breaker": "^0.4.0",
    "@backendkit-labs/pipeline": "^0.3.2",
    "@backendkit-labs/result": "^0.2.1",
    "@backendkit-labs/retry": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-cron": "^4.2.1",
    "yaml": "^2.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
