# Enterprise Agent — Local LLM + Knowledge Base
# Make sure Ollama is running before starting: ollama serve
# Pull required models: ollama pull llama3.2 && ollama pull nomic-embed-text

# Local LLM (via Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings model for knowledge base search
EMBEDDING_MODEL=nomic-embed-text

# Absolute path to your Obsidian vault
VAULT_PATH=/path/to/your/Obsidian/Vault
