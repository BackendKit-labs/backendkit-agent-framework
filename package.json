{
    "name":  "agent-framework",
    "version":  "0.14.0",
    "private":  true,
    "workspaces":  [
                       "packages/*",
                       "agents/*",
                       "apps/*"
                   ],
    "scripts":  {
                    "build":  "npm run build --workspaces --if-present",
                    "dev":  "npm run dev --workspaces --if-present",
