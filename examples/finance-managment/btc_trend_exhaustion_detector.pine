//@version=6
indicator("BTC Trend Exhaustion Detector v2", overlay = true)

// ── CONFIGURACIÓN ─────────────────────────────────────────────────────────────
int    rsi_length       = input.int(14,    title = "RSI Length")
int    mfi_length       = input.int(14,    title = "MFI Length")
int    volume_ma_length = input.int(20,    title = "Volume MA Length")
int    pivot_bars       = input.int(5,     title = "Pivot Lookback")
int    pct_lookback     = input.int(200,   title = "Lookback Percentil Dinamico")
bool   use_htf          = input.bool(true, title = "Confirmar en Timeframe Superior")
string htf_tf           = input.timeframe("D", title = "Timeframe Superior")

// ── INDICADORES BASE ──────────────────────────────────────────────────────────
float rsi          = ta.rsi(close, rsi_length)
float mfi          = ta.mfi(close, mfi_length)
float volume_ma    = ta.sma(volume, volume_ma_length)
float volume_ratio = volume / volume_ma
float ema_fast     = ta.ema(close, 20)
float ema_slow     = ta.ema(close, 50)
bool  ema_trend    = ema_fast > ema_slow
[macd_line, signal_line, _] = ta.macd(close, 12, 26, 9)

// ── 1. CONTEXTO DE MERCADO (regimen semanal) ──────────────────────────────────
float w_close  = request.security(syminfo.tickerid, "W", close)
float w_ema50  = request.security(syminfo.tickerid, "W", ta.ema(close, 50))
float w_ema200 = request.security(syminfo.tickerid, "W", ta.ema(close, 200))

bool bull_market = w_close > w_ema200 and w_ema50 > w_ema200
bool bear_market = w_close < w_ema200 and w_ema50 < w_ema200

string market_regime = bull_market ? "BULL" : bear_market ? "BEAR" : "RANGING"
color  regime_color  = bull_market ? color.green : bear_market ? color.red : color.yellow

// ── 2. UMBRALES DINAMICOS (percentil sobre ventana rodante) ───────────────────
// ta.percentrank devuelve % de valores < actual en los ultimos N periodos
// >= 90 significa que el valor actual esta en el top 10% historico
float rsi_rank = ta.percentrank(rsi,    pct_lookback)
float mfi_rank = ta.percentrank(mfi,    pct_lookback)
float vol_rank = ta.percentrank(volume, pct_lookback)

bool overbought_rsi = rsi_rank >= 90
bool overbought_mfi = mfi_rank >= 90

// ── SENALES DE AGOTAMIENTO ────────────────────────────────────────────────────
bool trend_weakening       = ema_trend and ema_fast < ema_fast[1] and ema_fast[1] < ema_fast[2]
bool macd_bearish          = macd_line < signal_line
bool high_distribution     = vol_rank >= 90 and close < open
bool moderate_distribution = vol_rank >= 75 and vol_rank < 90 and close < open and close < close[1]

// Divergencia bajista real con pivot highs
float ph = ta.pivothigh(high, pivot_bars, pivot_bars)

var float ph1_price = na
var float ph1_rsi   = na
var float ph2_price = na
var float ph2_rsi   = na

if not na(ph)
    ph2_price := ph1_price
    ph2_rsi   := ph1_rsi
    ph1_price := ph
    ph1_rsi   := rsi[pivot_bars]

bool bearish_divergence = not na(ph1_price) and not na(ph2_price) and
                          ph1_price > ph2_price and
                          ph1_rsi   < ph2_rsi   and
                          ph1_rsi   > 65

// ── 3. CONFIRMACION MULTI-TIMEFRAME ──────────────────────────────────────────
float htf_rsi = request.security(syminfo.tickerid, htf_tf, ta.rsi(close, 14))
float htf_ef  = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 20))
float htf_es  = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 50))

// HTF confirmado: RSI elevado en TF superior Y tendencia ya girada bajista
bool mtf_confirmed = use_htf and htf_rsi > 65 and htf_ef < htf_es

// ── 4. PUNTUACION CON UMBRALES ADAPTATIVOS POR REGIMEN ───────────────────────
// Max base: 1+1+1+1+2+3 = 9 pts | Con MTF: +2 → max 11 pts
int exhaustion_score = (overbought_rsi         ? 1 : 0) +
                       (overbought_mfi         ? 1 : 0) +
                       (trend_weakening        ? 1 : 0) +
                       (macd_bearish           ? 1 : 0) +
                       (high_distribution      ? 2 : moderate_distribution ? 1 : 0) +
                       (bearish_divergence     ? 3 : 0) +
                       (mtf_confirmed          ? 2 : 0)

// Bull market exige mas puntos para escalar el riesgo (aguanta sobrecompra)
// Bear market escala rapido (rebotes se agotan con menos señales)
int thresh_medium   = bull_market ? 4 : bear_market ? 2 : 3
int thresh_high     = bull_market ? 6 : bear_market ? 4 : 5
int thresh_critical = bull_market ? 8 : bear_market ? 6 : 7

// ── NIVELES DE RIESGO ─────────────────────────────────────────────────────────
var string risk_level = "BAJO"
var color  risk_color = color.green

if exhaustion_score >= thresh_critical
    risk_level := "CRITICO"
    risk_color := color.red
else if exhaustion_score >= thresh_high
    risk_level := "ALTO"
    risk_color := color.orange
else if exhaustion_score >= thresh_medium
    risk_level := "MEDIO"
    risk_color := color.yellow
else
    risk_level := "BAJO"
    risk_color := color.green

// ── VISUALIZACION ─────────────────────────────────────────────────────────────
bgcolor(exhaustion_score >= thresh_critical ? color.new(color.red, 90)    :
        exhaustion_score >= thresh_high     ? color.new(color.orange, 90) :
        exhaustion_score >= thresh_medium   ? color.new(color.yellow, 90) : na)

plotshape(exhaustion_score >= thresh_critical,
          "Critical Exhaustion", shape.triangledown, location.abovebar,
          color=color.red, size=size.large, text="TOP!")
plotshape(exhaustion_score >= thresh_high and exhaustion_score < thresh_critical,
          "High Exhaustion", shape.xcross, location.abovebar,
          color=color.orange, size=size.normal, text="CAUTION")
plotshape(bearish_divergence,
          "Bearish Divergence", shape.circle, location.abovebar,
          color=color.purple, size=size.small, text="DIV")
plotshape(mtf_confirmed and exhaustion_score >= thresh_medium,
          "MTF Confirmed", shape.diamond, location.abovebar,
          color=color.blue, size=size.small, text="MTF")

plot(ema_fast, "EMA Fast", color=color.blue, linewidth=1)
plot(ema_slow, "EMA Slow", color=color.red,  linewidth=1)

// ── TABLA ─────────────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 10), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "BTC EXHAUSTION v2", text_color=color.white, bgcolor=color.new(color.blue, 80))
    table.cell(t, 1, 0, "SCORE: " + str.tostring(exhaustion_score, "#"), text_color=color.white, bgcolor=color.new(color.blue, 80))

    table.cell(t, 0, 1, "REGIMEN", text_color=color.white)
    table.cell(t, 1, 1, market_regime + " (crit: >=" + str.tostring(thresh_critical, "#") + ")", text_color=regime_color)

    table.cell(t, 0, 2, "RIESGO", text_color=color.white)
    table.cell(t, 1, 2, risk_level + " (" + str.tostring(exhaustion_score, "#") + "/11)", text_color=risk_color)

    table.cell(t, 0, 3, "TENDENCIA", text_color=color.white)
    table.cell(t, 1, 3, ema_trend ? "ALCISTA" : "BAJISTA", text_color=ema_trend ? color.green : color.red)

    table.cell(t, 0, 4, "RSI", text_color=color.white)
    table.cell(t, 1, 4,
               str.tostring(rsi, "#.#") + " [pct " + str.tostring(rsi_rank, "#") + "]",
               text_color=rsi_rank >= 90 ? color.red : rsi_rank >= 75 ? color.orange : color.green)

    table.cell(t, 0, 5, "MFI", text_color=color.white)
    table.cell(t, 1, 5,
               str.tostring(mfi, "#.#") + " [pct " + str.tostring(mfi_rank, "#") + "]",
               text_color=mfi_rank >= 90 ? color.red : mfi_rank >= 75 ? color.orange : color.green)

    table.cell(t, 0, 6, "VOLUMEN", text_color=color.white)
    table.cell(t, 1, 6,
               str.tostring(volume_ratio, "#.##") + "x [pct " + str.tostring(vol_rank, "#") + "]",
               text_color=vol_rank >= 90 ? color.red : vol_rank >= 75 ? color.orange : color.green)

    table.cell(t, 0, 7, "MACD", text_color=color.white)
    table.cell(t, 1, 7,
               macd_line > signal_line ? "ALCISTA" : "BAJISTA",
               text_color=macd_line > signal_line ? color.green : color.red)

    table.cell(t, 0, 8, "DIVERGENCIA", text_color=color.white)
    table.cell(t, 1, 8,
               bearish_divergence ? "BAJISTA" : "NINGUNA",
               text_color=bearish_divergence ? color.red : color.green)

    table.cell(t, 0, 9, "MTF (" + htf_tf + ")", text_color=color.white)
    table.cell(t, 1, 9,
               mtf_confirmed ? "CONFIRMADO" : "NEUTRAL",
               text_color=mtf_confirmed ? color.red : color.green)

    table.cell(t, 0, 10, "SENALES ACTIVAS", text_color=color.white)
    string sigs = ""
    sigs := overbought_rsi        ? sigs + "RSI "  : sigs
    sigs := overbought_mfi        ? sigs + "MFI "  : sigs
    sigs := bearish_divergence    ? sigs + "DIV "  : sigs
    sigs := high_distribution     ? sigs + "VOL++ " : sigs
    sigs := moderate_distribution ? sigs + "VOL+ "  : sigs
    sigs := mtf_confirmed         ? sigs + "MTF "  : sigs
    sigs := sigs == ""            ? "NINGUNA"      : sigs
    table.cell(t, 1, 10, sigs, text_color=sigs != "NINGUNA" ? color.orange : color.gray)

    table.cell(t, 0, 11, "UMBRALES", text_color=color.white)
    table.cell(t, 1, 11,
               "M>=" + str.tostring(thresh_medium, "#") +
               "  A>=" + str.tostring(thresh_high, "#") +
               "  C>=" + str.tostring(thresh_critical, "#"),
               text_color=regime_color)

    table.cell(t, 0, 12, "ACCION", text_color=color.white)
    string rec = exhaustion_score >= thresh_critical ? "TOMAR GANANCIAS"  :
                 exhaustion_score >= thresh_high     ? "REDUCIR POSICION" :
                 exhaustion_score >= thresh_medium   ? "MONITOREAR"       : "MANTENER"
    table.cell(t, 1, 12, rec,
               text_color=exhaustion_score >= thresh_critical ? color.red    :
                          exhaustion_score >= thresh_high     ? color.orange :
                          exhaustion_score >= thresh_medium   ? color.yellow : color.green)

// ── ALERTAS ───────────────────────────────────────────────────────────────────
alertcondition(exhaustion_score >= thresh_critical, "BTC Critical Exhaustion", "Riesgo critico de fin de tendencia alcista en BTC")
alertcondition(exhaustion_score >= thresh_high,     "BTC High Exhaustion",     "Riesgo alto de correccion en BTC")
alertcondition(bearish_divergence,                  "BTC Bearish Divergence",  "Divergencia bajista detectada en BTC")
alertcondition(mtf_confirmed,                       "BTC MTF Confirmed",       "Senales confirmadas en timeframe superior")

// ── LABEL ─────────────────────────────────────────────────────────────────────
var label lbl = na
if barstate.islast
    label.delete(lbl)
    lbl := label.new(
         bar_index, high,
         "Score: " + str.tostring(exhaustion_score, "#") + "/11" +
         " | " + market_regime + " | " + risk_level + "\n" +
         "RSI: " + str.tostring(rsi, "#.#") + " [" + str.tostring(rsi_rank, "#") + "%]" +
         "  MFI: " + str.tostring(mfi, "#.#") + " [" + str.tostring(mfi_rank, "#") + "%]\n" +
         "MTF(" + htf_tf + "): " + (mtf_confirmed ? "BAJISTA" : "NEUTRAL"),
         color=color.new(color.black, 80), textcolor=color.white,
         style=label.style_label_down, yloc=yloc.abovebar)
