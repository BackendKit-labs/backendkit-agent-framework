//@version=6
indicator("Smart Money Flow Tracker", overlay = true)

// ── CONFIGURACION ──────────────────────────────────────────────────────────────
int   conv_period  = input.int(10,    title = "Conviction Period",       minval = 3,   maxval = 50)
int   flow_period  = input.int(20,    title = "Net Flow Period",         minval = 5,   maxval = 50)
int   vol_period   = input.int(20,    title = "Volume MA Period",        minval = 5,   maxval = 50)
float whale_mult   = input.float(3.0, title = "Whale Volume Multiplier", minval = 1.5, maxval = 10.0, step = 0.5)
bool  show_signals = input.bool(true, title = "Mostrar Senales en Chart")

// ── BASE ────────────────────────────────────────────────────────────────────────
float vol_ma    = ta.sma(volume, vol_period)
float atr       = ta.atr(14)
float bar_range = high - low

// ── 1. CONVICTION ─────────────────────────────────────────────────────────────
// Mapea calculateConviction() del agente SmartMoneyTrackerAgent
// Posicion del cierre dentro del rango = conviction de la barra
// 1.0 = cierro en el maximo (max conviction alcista)
// 0.0 = cierro en el minimo (max conviction bajista)
float bar_conv   = bar_range > 0 ? (close - low) / bar_range : 0.5
float vol_weight = volume / vol_ma
// Weighted conviction escalada a -N/+N, luego suavizada
float weighted_c   = (bar_conv - 0.5) * 2.0 * vol_weight
float rolling_conv = ta.ema(weighted_c, conv_period)
// Normalizada a 0-1 para mostrar en tabla (como el campo conviction de la entidad)
float conviction   = math.max(0.0, math.min(1.0, (rolling_conv + 3.0) / 6.0))

// ── 2. NET FLOW / CVD ─────────────────────────────────────────────────────────
// Mapea el campo netFlow del SmartMoneyResult
// Delta = volumen direccional ponderado por conviccion de la barra
float delta   = close >= open ? volume * bar_conv : -(volume * (1.0 - bar_conv))
float cvd_cum = ta.cum(delta)
float cvd_ema = ta.ema(delta, flow_period)
bool  flow_up = cvd_ema > cvd_ema[1]
bool  flow_dn = cvd_ema < cvd_ema[1]

// ── 3. SIGNAL TYPE — espejo del enum SignalType ────────────────────────────────
bool   sig_bullish = rolling_conv > 0.3 and flow_up
bool   sig_bearish = rolling_conv < -0.3 and flow_dn
string signal_type = sig_bullish ? "BULLISH" : sig_bearish ? "BEARISH" : "NEUTRAL"
color  signal_color = sig_bullish ? color.green : sig_bearish ? color.red : color.gray

// ── 4. WHALE DETECTION — espejo de SignalSource.WHALE ─────────────────────────
// Volumen > N veces la media con conviction direccional alta
bool whale_bull = volume > vol_ma * whale_mult and bar_conv > 0.6 and close > open
bool whale_bear = volume > vol_ma * whale_mult and bar_conv < 0.4 and close < open

// ── 5. ABSORCION — equivalente a actividad institucional (SignalSource.FORM_4) ──
// Smart money absorbe oferta/demanda: volumen alto + rango pequeno vs ATR
float effort  = atr > 0 ? bar_range / atr : 1.0
bool  abs_bull = volume > vol_ma * 2.0 and effort < 0.5 and close > open
bool  abs_bear = volume > vol_ma * 2.0 and effort < 0.5 and close < open

// ── 6. DIVERGENCIA PRECIO / FLUJO — equivalente a ETF_FLOW ────────────────────
// Precio sube pero CVD baja = distribucion oculta (institucionales vendiendo a retail)
// Precio baja pero CVD sube = acumulacion oculta (institucionales comprando el descenso)
bool div_bear = close > close[conv_period] and cvd_cum < cvd_cum[conv_period]
bool div_bull = close < close[conv_period] and cvd_cum > cvd_cum[conv_period]

// ── 7. INVESTOR COUNT — espejo del campo investorCount ────────────────────────
// Conteo de velas con actividad whale en el periodo reciente
int investor_count = 0
for i = 0 to conv_period - 1
    if volume[i] > vol_ma[i] * whale_mult
        investor_count := investor_count + 1

// ── 8. CO-INVESTMENT CLUSTER — espejo de CoInvestmentCluster ─────────────────
// Espejo de classifySignalStrength(): multiple condiciones simultaneas = cluster fuerte
int cluster_pts = (whale_bull or whale_bear  ? 2 : 0) +
                  (abs_bull   or abs_bear    ? 2 : 0) +
                  (div_bull   or div_bear    ? 2 : 0) +
                  (math.abs(rolling_conv) > 0.5 ? 2 : math.abs(rolling_conv) > 0.3 ? 1 : 0) +
                  (volume > vol_ma * 1.5 ? 1 : 0)

// Umbrales mapeados de classifySignalStrength del agente
// VERY_STRONG: >= 15 inversores + $5B → cluster_pts >= 7
// STRONG:      >=  8 inversores + $500M → cluster_pts >= 5
// MODERATE:    >=  4 inversores + $50M  → cluster_pts >= 3
string cluster_str = cluster_pts >= 7 ? "VERY_STRONG" :
                     cluster_pts >= 5 ? "STRONG"      :
                     cluster_pts >= 3 ? "MODERATE"    : "WEAK"
bool   has_cluster  = cluster_pts >= 5
string cluster_dir  = rolling_conv >= 0 ? "ACCUMULATING" : "DISTRIBUTING"

// ── FUENTE DOMINANTE — espejo de SignalSource ──────────────────────────────────
string source = whale_bull or whale_bear ? "WHALE" :
                abs_bull   or abs_bear   ? "INST"  :
                div_bull   or div_bear   ? "FLOW"  : "MIXED"

// ── VISUALIZACION ─────────────────────────────────────────────────────────────
bgcolor(sig_bullish and has_cluster ? color.new(color.green, 92) :
        sig_bearish and has_cluster ? color.new(color.red,   92) : na)

// Whales
plotshape(show_signals and whale_bull, "Whale Bull", shape.triangleup,   location.belowbar,
          color=color.teal,   size=size.normal, text="WHALE")
plotshape(show_signals and whale_bear, "Whale Bear", shape.triangledown, location.abovebar,
          color=color.maroon, size=size.normal, text="WHALE")

// Absorcion institucional
plotshape(show_signals and abs_bull, "Abs Bull", shape.circle, location.belowbar,
          color=color.blue,   size=size.small, text="ABS")
plotshape(show_signals and abs_bear, "Abs Bear", shape.circle, location.abovebar,
          color=color.purple, size=size.small, text="ABS")

// Divergencias precio/flujo
plotshape(show_signals and div_bull, "Div Bull", shape.xcross, location.belowbar,
          color=color.lime,   size=size.small, text="DIV+")
plotshape(show_signals and div_bear, "Div Bear", shape.xcross, location.abovebar,
          color=color.orange, size=size.small, text="DIV-")

// Clusters fuertes
plotshape(has_cluster and cluster_pts >= 7, "Very Strong Cluster", shape.labelup, location.belowbar,
          color=color.yellow, size=size.large, text="SM+")
plotshape(has_cluster and cluster_pts >= 5 and cluster_pts < 7, "Strong Cluster", shape.labelup, location.belowbar,
          color=color.orange, size=size.normal, text="SM")

// ── TABLA — espejo del interface SmartMoneyResult ─────────────────────────────
var table t = table.new(position.bottom_left, 2, 9, bgcolor=color.new(color.black, 10), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "SMART MONEY TRACKER", text_color=color.white, bgcolor=color.new(color.blue, 20))
    table.cell(t, 1, 0, syminfo.tickerid,       text_color=color.white, bgcolor=color.new(color.blue, 20))

    // signalType
    table.cell(t, 0, 1, "SIGNAL TYPE", text_color=color.white)
    table.cell(t, 1, 1, signal_type, text_color=signal_color)

    // conviction (0-1) — como el campo conviction de SmartMoneySignal
    table.cell(t, 0, 2, "CONVICTION", text_color=color.white)
    string conv_label = conviction >= 0.7 ? "ALTA" : conviction >= 0.4 ? "MEDIA" : "BAJA"
    table.cell(t, 1, 2,
               str.tostring(conviction, "#.##") + " [" + conv_label + "]",
               text_color=conviction >= 0.7 ? color.green : conviction >= 0.4 ? color.yellow : color.gray)

    // source — espejo de SignalSource enum
    table.cell(t, 0, 3, "SOURCE", text_color=color.white)
    color src_color = source == "WHALE" ? color.teal :
                      source == "INST"  ? color.blue :
                      source == "FLOW"  ? color.orange : color.gray
    table.cell(t, 1, 3, source, text_color=src_color)

    // netFlow — espejo del campo netFlow
    table.cell(t, 0, 4, "NET FLOW", text_color=color.white)
    string flow_label = flow_up ? "ENTRANDO" : flow_dn ? "SALIENDO" : "LATERAL"
    table.cell(t, 1, 4, flow_label, text_color=flow_up ? color.green : flow_dn ? color.red : color.gray)

    // investorCount — espejo del campo investorCount
    table.cell(t, 0, 5, "INVESTOR COUNT", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(investor_count, "#") + " activos",
               text_color=investor_count >= 3 ? color.green : color.gray)

    // coInvestmentCluster — espejo de CoInvestmentCluster
    table.cell(t, 0, 6, "CLUSTER", text_color=color.white)
    color clu_color = cluster_str == "VERY_STRONG" ? color.yellow :
                      cluster_str == "STRONG"      ? color.orange :
                      cluster_str == "MODERATE"    ? color.blue   : color.gray
    table.cell(t, 1, 6, cluster_str + " / " + cluster_dir, text_color=clu_color)

    // divergence
    table.cell(t, 0, 7, "DIVERGENCIA", text_color=color.white)
    string div_label = div_bull ? "ACUMULACION OCULTA" :
                       div_bear ? "DISTRIBUCION OCULTA" : "NINGUNA"
    table.cell(t, 1, 7, div_label,
               text_color=div_bull ? color.green : div_bear ? color.red : color.gray)

    // filingPeriod — espejo del campo filingPeriod (quarter actual)
    table.cell(t, 0, 8, "PERIODO", text_color=color.white)
    int qtr = (month - 1) / 3 + 1
    table.cell(t, 1, 8, str.tostring(year) + "-Q" + str.tostring(qtr), text_color=color.gray)

// ── ALERTAS ───────────────────────────────────────────────────────────────────
alertcondition(whale_bull,                       "SM Whale Bull",         "Whale alcista detectada")
alertcondition(whale_bear,                       "SM Whale Bear",         "Whale bajista detectada")
alertcondition(abs_bull,                         "SM Absorcion Bull",     "Absorcion alcista - posible acumulacion institucional")
alertcondition(abs_bear,                         "SM Absorcion Bear",     "Absorcion bajista - posible distribucion institucional")
alertcondition(div_bull,                         "SM Divergencia Bull",   "Acumulacion oculta: precio baja pero CVD sube")
alertcondition(div_bear,                         "SM Divergencia Bear",   "Distribucion oculta: precio sube pero CVD baja")
alertcondition(has_cluster and sig_bullish,       "SM Cluster Bullish",   "Cluster bullish STRONG/VERY_STRONG detectado")
alertcondition(has_cluster and sig_bearish,       "SM Cluster Bearish",   "Cluster bearish STRONG/VERY_STRONG detectado")
