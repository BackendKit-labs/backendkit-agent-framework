# LLM — any OpenAI-compatible endpoint
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Reasoning toggle for models that support it (DeepSeek V4 defaults to enabled). Optional.
# LLM_THINKING=disabled

# How /report asks for JSON: native (json_schema) | json_object | none.
# Default: json_object for DeepSeek URLs, native otherwise.
# LLM_STRUCTURED_OUTPUT=json_object

# Safe mode: only read-only git tools are registered (status, log, diff, show, blame, reflog).
# GIT_AGENT_READONLY=1

# Spending cap per run (USD). The run stops once it is crossed. Needs the prices below.
# GIT_AGENT_BUDGET_USD=0.05
# Approximate USD per million tokens of YOUR model — check your provider's price list.
# LLM_PRICE_IN_PER_M=0.30
# LLM_PRICE_OUT_PER_M=1.20
