# Application
NODE_ENV=development
PORT=3000

# Auth (unificado en abac-service — ver .specs/adr-unified-auth.md)
# AUTH_SECRET: clave compartida con auth-service para tokens HS256 (transitional).
AUTH_SECRET=mismo-valor-que-AUTH_SECRET-en-auth-service

# ABAC — abac-service como IdP+PDP central (puerto 3005)
# ABAC_PUBLIC_KEY: clave pública Ed25519 de abac-service (32 bytes, base64).
#   Se obtiene de apps/abac-service/.env.development → ED25519_PUBLIC_KEY
ABAC_PUBLIC_KEY=KjaHhk4qNBQFDPweXy1/H2cbE1GgUAa7Ns2k3fWXCk8=
# ABAC_BASE_URL: URL base de abac-service (sin trailing slash).
ABAC_BASE_URL=http://localhost:3005
# ABAC_M2M_TOKEN: JWT M2M de cloud-platform (generado por npm run seed:m2m en abac-service).
ABAC_M2M_TOKEN=
# ABAC_APP_ID: applicationId de cloud-platform registrado en abac-service (del seed:m2m).
ABAC_APP_ID=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cloud_platform
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# Runtime (Fase 1: RuntimeSPI)
# Endpoint del daemon Docker. Windows: npipe:////./pipe/docker_engine
DOCKER_HOST=unix:///var/run/docker.sock
# Runtimes habilitados (coma-separados). Hoy: docker. k8s/process = coming_soon.
RUNTIME_ENABLED=docker
# Imagen por defecto si el agente no define image/config.image.
DEFAULT_AGENT_IMAGE=agent-runtime:latest