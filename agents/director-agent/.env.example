# Copiá este archivo a .env y completá tus claves.
# El director usa el provider configurado en director.yaml (default: deepseek).

# LLM
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...   (si cambiás provider a openai en director.yaml)

# orchestrator-mcp-agent: path al yaml de configuración del orquestador
ORCHESTRATOR_CONFIG=../orchestrator-mcp-agent/orchestrator-mcp.yaml

# fleet-agent: gateway de despliegue Docker/K8s
GATEWAY_URL=http://localhost:3400
# GATEWAY_API_KEY=         (si el gateway fue levantado con ORCHESTRATOR_API_KEY)

# Ruta al director.yaml (opcional, si no está junto al binario)
# DIRECTOR_CONFIG=/path/to/director.yaml
