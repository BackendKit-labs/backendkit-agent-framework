{
  "name": "@backendkit-labs/agent-mandates",
  "version": "0.1.0",
  "description": "Mandates for @backendkit-labs/agent-core agents: a default verifier of signed power-of-representation credentials (JWT / SD-JWT VC shaped), with trusted issuers, expiry and revocation. The format of a specific provider is an adapter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "peerDependencies": {
    "@backendkit-labs/agent-core": ">=0.48.8 <0.49.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/mandates"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
