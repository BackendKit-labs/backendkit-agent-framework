  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "fflate": "^0.8.3",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
