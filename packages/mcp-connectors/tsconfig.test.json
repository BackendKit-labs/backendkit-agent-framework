{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "rootDir": "src",
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
