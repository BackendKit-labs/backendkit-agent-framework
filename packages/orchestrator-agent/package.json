{
  "name": "@backendkit-labs/orchestrator-agent",
  "version": "0.6.0",
  "description": "Config-driven orchestration agent — decomposes tasks and coordinates specialist agents via shared vault and configurable LLM providers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": "./dist/server.js"
  },
  "bin": {
    "orchestrator-agent": "./dist/server.js",
    "orchestrator-worker": "./dist/worker-process.js"
  },
  "files": [
    "dist/",
    "AGENT.md",
    "README.md",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/orchestrator-agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "dependencies": {
    "@backendkit-labs/agent-core": "^0.33.0",
    "@backendkit-labs/agent-enterprise": "^0.8.0",
    "@backendkit-labs/agent-providers": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@lancedb/lancedb": "^0.13.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "yaml": "^2.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.17.12",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.7.3"
  }
}
