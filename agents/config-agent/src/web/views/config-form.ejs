<h1>Configuración: <%= agent_id %></h1>
<p class="subtitle">Versión actual: <strong><%= currentVersion %></strong></p>

<% if (validation) { %>
<div class="validation-summary">
  <span class="badge badge-<%= validation.status === 'valid' ? 'ok' : (validation.status === 'incomplete' ? 'warning' : 'error') %>">
    <%= validation.status.toUpperCase() %>
  </span>
  <span><%= validation.passed %> checks OK</span>
  <% if (validation.failed > 0) { %><span class="text-error"><%= validation.failed %> errores</span><% } %>
  <% if (validation.missingRequired.length > 0) { %><span class="text-warning"><%= validation.missingRequired.length %> requeridos faltantes</span><% } %>
</div>
<% } %>

<form method="POST" action="/config/<%= agent_id %>">
  <% if (schema && schema.fields) { %>
    <% for (const [key, field] of Object.entries(schema.fields)) { %>
      <%- include('partials/field', { key, field, value: config[key], validation }) %>
    <% } %>
  <% } else { %>
    <% for (const [key, value] of Object.entries(config)) { %>
      <div class="field">
        <label for="<%= key %>"><%= key %></label>
        <input type="text" id="<%= key %>" name="<%= key %>" value="<%= typeof value === 'object' ? JSON.stringify(value) : value %>">
      </div>
    <% } %>
  <% } %>

  <div class="field">
    <label for="_message">Mensaje (opcional)</label>
    <input type="text" id="_message" name="_message" placeholder="web update">
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">💾 Guardar</button>
    <a href="/history/<%= agent_id %>" class="btn">📋 Historial</a>
    <a href="/diff/<%= agent_id %>" class="btn">📊 Diff</a>
  </div>
</form>
