<% 
  const value = locals.value !== undefined ? locals.value : '';
  const check = locals.validation?.checks?.find(c => c.key === key);
  let statusClass = 'status-unknown';
  let statusIcon = '⚪';
  if (check) {
    if (check.status === 'ok') { statusClass = 'status-ok'; statusIcon = '✅'; }
    else if (check.status === 'missing') { statusClass = 'status-error'; statusIcon = '❌'; }
    else if (check.status === 'invalid_format') { statusClass = 'status-error'; statusIcon = '❌'; }
    else if (check.status === 'expired') { statusClass = 'status-warning'; statusIcon = '⚠️'; }
  }
%>
<div class="field <%= statusClass %>">
  <label for="<%= key %>">
    <%= key %>
    <% if (field.required) { %><span class="required">*</span><% } %>
  </label>
  <div class="field-input-group">
    <% if (field.type === 'boolean') { %>
      <input type="checkbox" id="<%= key %>" name="<%= key %>" <%= value ? 'checked' : '' %> value="true">
    <% } else if (field.type === 'number') { %>
      <input type="number" id="<%= key %>" name="<%= key %>" value="<%= value %>"
        <%= field.min !== undefined ? `min="${field.min}"` : '' %>
        <%= field.max !== undefined ? `max="${field.max}"` : '' %>>
    <% } else if (field.type === 'select' && field.options) { %>
      <select id="<%= key %>" name="<%= key %>">
        <% for (const opt of field.options) { %>
          <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
        <% } %>
      </select>
    <% } else if (field.type === 'secret' || field.secret) { %>
      <input type="password" id="<%= key %>" name="<%= key %>" value="<%= value %>" placeholder="••••••••">
      <button type="button" class="btn-icon toggle-password" data-target="<%= key %>">👁️</button>
    <% } else if (field.type === 'url') { %>
      <input type="url" id="<%= key %>" name="<%= key %>" value="<%= value %>" placeholder="https://...">
    <% } else { %>
      <input type="text" id="<%= key %>" name="<%= key %>" value="<%= value %>"
        <%= field.pattern ? `pattern="${field.pattern}"` : '' %>
        placeholder="<%= field.placeholder || '' %>">
    <% } %>
    <span class="status-icon"><%= statusIcon %></span>
  </div>
  <% if (field.description) { %><p class="field-desc"><%= field.description %></p><% } %>
  <% if (check && check.message) { %><p class="field-msg"><%= check.message %></p><% } %>
</div>
