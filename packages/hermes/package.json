{
  "name": "@backendkit-labs/hermes",
  "version": "0.4.0",
  "description": "Control plane for a fleet of agents: a validated fleet.yaml, connectors (in-process, agent-protocol), run store with reconciliation, roles and approval, and the fleet_* / agent_* tools for @backendkit-labs/agent-core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bk-hermes": "./dist/bin/bk-hermes.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "dependencies": {
    "yaml": "^2.4.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@backendkit-labs/agent-core": ">=0.33.0 <0.36.0",
    "@backendkit-labs/agent-sandbox": "^0.1.2",
    "@backendkit-labs/agent-protocol": ">=0.3.0 <0.7.0"
  },
  "devDependencies": {
    "@backendkit-labs/agent-sandbox": "^0.1.2",
    "@backendkit-labs/agent-testkit": "^0.1.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agent-framework.git",
    "directory": "packages/hermes"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
