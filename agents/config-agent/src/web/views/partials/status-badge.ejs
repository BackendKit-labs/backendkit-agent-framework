<% 
  const statusMap = {
    'ok': { class: 'badge-ok', icon: '✅' },
    'warning': { class: 'badge-warning', icon: '⚠️' },
    'error': { class: 'badge-error', icon: '❌' },
    'unknown': { class: 'badge-unknown', icon: '⚪' },
  };
  const s = statusMap[locals.status || 'unknown'];
%>
<span class="badge <%= s.class %>"><%= s.icon %> <%= locals.label || locals.status %></span>
