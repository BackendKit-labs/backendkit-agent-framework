# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=abac_user
DB_PASSWORD=change_me
DB_NAME=abac_db

# JWT — symmetric (HS256) para sesiones internas
JWT_SECRET=change_me_32_chars_minimum
JWT_EXPIRES_IN=7d

# EdDSA keypair — used to sign tokens verified by director-api and other services
# Generate with: node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey,publicKey}=generateKeyPairSync('ed25519'); console.log(privateKey.export({type:'pkcs8',format:'pem'})); console.log(publicKey.export({type:'spki',format:'pem'}))"
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Puerto del servicio
PORT=3005

# Logging
LOG_LEVEL=info
