# Copia este archivo a .env y completa tus claves.
# El director usa el provider configurado en director.yaml (default: deepseek).

# LLM
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...   (si cambias provider a openai en director.yaml)

# orchestrator-mcp-agent: ~/.backendkit/config/orchestrator-mcp.yaml se crea
# automaticamente en el primer arranque. Descomenta solo si usas config custom.
# ORCHESTRATOR_CONFIG=/ruta/personalizada/orchestrator-mcp.yaml

# fleet-agent: gateway de despliegue Docker/K8s
GATEWAY_URL=http://localhost:3400
# GATEWAY_API_KEY=         (si el gateway fue levantado con ORCHESTRATOR_API_KEY)

# Ruta al director.yaml (opcional, si no esta junto al binario)
# DIRECTOR_CONFIG=/path/to/director.yaml

# ── Auth Service (autenticación centralizada) ─────────────────────────────────
# AUTH_SECRET: clave compartida entre auth-service y director para firmar/verificar JWTs.
# auth-service FIRMA los tokens con esta clave; el director los VERIFICA con ella.
# Debe ser IDÉNTICA (mismo valor exacto) en apps/auth-service/.env.local y aquí.
#
# ⚠️ Si usás auth-service, AUTH_SECRET es OBLIGATORIO. El director resuelve la clave
#    como (AUTH_SECRET ?? JWT_SECRET): si AUTH_SECRET falta pero JWT_SECRET está
#    seteado (legacy), el director verificará con la clave equivocada y RECHAZARÁ
#    todo login con "Token inválido" — incluido admin, aunque el password sea correcto.
#    Síntoma típico: "entro como admin y no me deja". → setear AUTH_SECRET = el de auth-service.
#
# Solo si NI AUTH_SECRET NI JWT_SECRET están seteados → modo dev/REPL (admin implícito).
# AUTH_SECRET=clave-compartida-con-auth-service

# AUTH_SERVICE_URL: URL del auth-service que gestiona usuarios.
# Default: http://localhost:4000
# AUTH_SERVICE_URL=http://localhost:4000

# DIRECTOR_REGISTRY_PATH: dónde el director publica el registry de tools que
# lee el auth-service para el workspace editor.
# Default: ~/.backendkit/auth/director-registry.json
# DIRECTOR_REGISTRY_PATH=/ruta/personalizada/director-registry.json

# ── Legacy (solo director sin auth-service) ────────────────────────────────────
# JWT_SECRET: se sigue soportando por compatibilidad si NO usás auth-service.
# AUTH_SECRET tiene prioridad sobre JWT_SECRET.
# ⚠️ Si usás auth-service, NO dejes JWT_SECRET con un valor distinto a AUTH_SECRET:
#    sin AUTH_SECRET, el director cae a este JWT_SECRET y falla la verificación
#    (ver la nota de AUTH_SECRET arriba). Lo más seguro es setear AUTH_SECRET y
#    dejar JWT_SECRET sin usar.
# JWT_SECRET=cambia-esta-clave-en-produccion

# ── config-agent ──────────────────────────────────────────────────────────────
# CONFIG_MASTER_KEY: clave AES-256 hex (64 chars) para encriptar secretos.
# Si no se setea, el agente genera una automáticamente (se pierde al reiniciar).
# CONFIG_MASTER_KEY=

# Nota: la gestión de usuarios vive en auth-service (http://localhost:4000/admin/users).
# El primer admin se crea con el setup de un solo uso del auth-service.

# ── schedule-agent ────────────────────────────────────────────────────────────
# URL del orquestador (también usada por health-checker)
ORCHESTRATOR_URL=http://localhost:3000
# URL del scheduler (usada por notification-agent para notify_scheduled)
SCHEDULER_URL=http://localhost:3100

# ── notification-agent ────────────────────────────────────────────────────────
# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Discord
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...
# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASS=