<h1>Diff: <%= agent_id %></h1>

<form method="GET" action="/diff/<%= agent_id %>" class="diff-selector">
  <select name="v1">
    <% for (const v of versions) { %>
      <option value="<%= v.version %>" <%= v.version === v1 ? 'selected' : '' %>><%= v.version %> - <%= v.message %></option>
    <% } %>
  </select>
  <span>vs</span>
  <select name="v2">
    <% for (const v of versions) { %>
      <option value="<%= v.version %>" <%= v.version === v2 ? 'selected' : '' %>><%= v.version %> - <%= v.message %></option>
    <% } %>
  </select>
  <button type="submit" class="btn">📊 Comparar</button>
</form>

<% if (diff) { %>
  <div class="diff-summary"><%= diff.summary %></div>
  <table class="diff-table">
    <thead>
      <tr>
        <th>Clave</th>
        <th>Tipo</th>
        <th>Valor anterior (<%= v1 %>)</th>
        <th>Valor nuevo (<%= v2 %>)</th>
      </tr>
    </thead>
    <tbody>
      <% for (const change of diff.changes) { %>
        <tr class="diff-<%= change.type %>">
          <td><strong><%= change.key %></strong></td>
          <td><span class="badge badge-<%= change.type %>"><%= change.type %></span></td>
          <td class="diff-old"><%= change.from !== undefined ? JSON.stringify(change.from) : '-' %></td>
          <td class="diff-new"><%= change.to !== undefined ? JSON.stringify(change.to) : '-' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } else { %>
  <p>Seleccioná dos versiones diferentes para comparar.</p>
<% } %>
