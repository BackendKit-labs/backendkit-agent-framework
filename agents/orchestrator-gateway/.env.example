GATEWAY_PORT=3400

# ── Orchestrator connection (elegí un modo) ───────────────────────────────────
# Modo HTTP (producción): el orquestador corre como servicio independiente.
# ORCHESTRATOR_HTTP_URL=http://localhost:3600

# Modo stdio (dev local, DEFAULT): el gateway spawnea el orchestrator-mcp-agent.
# Defaults al layout del monorepo y a la config estándar de BK_HOME:
#   ORCHESTRATOR_SERVER = ../orchestrator-mcp-agent/dist/server.js
#   ORCHESTRATOR_CONFIG = ~/.backendkit/config/orchestrator-mcp.yaml
# Descomentá solo para overridear:
# ORCHESTRATOR_SERVER=/ruta/a/orchestrator-mcp-agent/dist/server.js
# ORCHESTRATOR_CONFIG=/ruta/a/orchestrator-mcp.yaml

# Puertos de los agentes downstream (deben coincidir con los agentes corriendo)
TRIAGE_PORT=3301
FORMATTER_PORT=3302
CURATOR_PORT=3200
SYNTHESIZER_PORT=3303

# Vault + auth
VAULT_PATH=
CURATOR_HTTP_API_KEY=
